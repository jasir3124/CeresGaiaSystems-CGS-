# Required: map style, satellite imagery, and geocoding
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Optional but recommended: real current/forecast weather from Meteomatics.
# These are SERVER-ONLY credentials; never prepend NEXT_PUBLIC_ to these.
METEOMATICS_USERNAME=your_meteomatics_username
METEOMATICS_PASSWORD=your_meteomatics_password

# NASA POWER / GIBS do not require keys.
